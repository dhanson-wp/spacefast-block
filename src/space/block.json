{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"version": "0.2.0",
	"name": "spacefast/space",
	"title": "Spacefast",
	"category": "media",
	"description": "Show a Spacefast Space inline, full page, as a card, or as a link.",
	"keywords": [ "space", "spacefast", "app", "prototype" ],
	"textdomain": "spacefast-block",
	"attributes": {
		"url": { "type": "string", "default": "" },
		"spaceId": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"description": { "type": "string", "default": "" },
		"hostname": { "type": "string", "default": "" },
		"imageUrl": { "type": "string", "default": "" },
		"imageId": { "type": "number", "default": 0 },
		"isFrameable": { "type": "boolean", "default": true },
		"isPrivate": { "type": "boolean", "default": false },
		"display": {
			"type": "string",
			"enum": [ "inline", "fullpage", "card", "link" ],
			"default": "inline"
		},
		"clickAction": {
			"type": "string",
			"enum": [ "modal", "link" ],
			"default": "modal"
		},
		"startPath": { "type": "string", "default": "" },
		"minHeight": { "type": "number" },
		"minHeightUnit": { "type": "string", "default": "px" },
		"showTitleBar": { "type": "boolean", "default": false },
		"showBranding": { "type": "boolean", "default": true },
		"hideHeader": { "type": "boolean", "default": false },
		"hideFooter": { "type": "boolean", "default": false },
		"fitContent": { "type": "boolean", "default": true },
		"imagePosition": {
			"type": "string",
			"enum": [ "top", "side" ],
			"default": "top"
		},
		"showImage": { "type": "boolean", "default": true },
		"showDescription": { "type": "boolean", "default": true },
		"showHostname": { "type": "boolean", "default": true },
		"linkLabel": { "type": "string", "default": "" },
		"openInNewTab": { "type": "boolean", "default": false },
		"expandInModal": { "type": "boolean", "default": false },
		"modalExternalLink": { "type": "boolean", "default": true },
		"lazyLoad": { "type": "boolean", "default": true },
		"allowFullscreen": { "type": "boolean", "default": true },
		"showPrivateBadge": { "type": "boolean", "default": true },
		"privateLabel": { "type": "string", "default": "" },
		"privateCta": { "type": "string", "default": "" }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"spacing": { "margin": true, "padding": true },
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		},
		"shadow": true,
		"color": {
			"text": true,
			"background": true,
			"__experimentalSkipSerialization": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalSkipSerialization": [ "fontSize" ]
		},
		"dimensions": { "aspectRatio": true },
		"interactivity": { "interactive": true }
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}
